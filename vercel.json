{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/category/:path*",
      "destination": "/"
    },
    {
      "source": "/product-page/:path*",
      "destination": "/"
    },
    {
      "source": "/product/:path*",
      "destination": "/"
    },
    {
      "source": "/catalogue/:path*",
      "destination": "/"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/"
    },
    {
      "source": "/refund-cancellation-policy",
      "destination": "/"
    },
    {
      "source": "/shipping-policy",
      "destination": "/"
    },
    {
      "source": "/privacy-policy",
      "destination": "/"
    }
  ]
}
